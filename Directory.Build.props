<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>AMWAG Travel</Company>
    <Product>AMWAG Printer Setup</Product>
    <Copyright>Copyright © 2026 AMWAG Travel</Copyright>
    <Version>1.0.0</Version>
    <!-- Only English and Arabic framework resources are shipped with the self-contained build. -->
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Symbols travel inside each assembly, so the single-file exe needs no loose .pdb files next to it. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
