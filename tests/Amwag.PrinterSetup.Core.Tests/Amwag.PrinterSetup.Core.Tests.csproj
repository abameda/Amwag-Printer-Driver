<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Amwag.PrinterSetup.Core\Amwag.PrinterSetup.Core.csproj" />
    <ProjectReference Include="..\Amwag.PrinterSetup.Testing\Amwag.PrinterSetup.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The shipped deployment configuration is validated by tests. -->
  <ItemGroup>
    <None Include="..\..\config\amwag-printer-config.json" Link="TestData\amwag-printer-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
